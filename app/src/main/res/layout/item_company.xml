<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="model"
            type="com.ailetv.mobile.data.model.resource.CampaignModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:background="?android:colorBackground">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/itemCv"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginHorizontal="48dp"
            android:layout_marginTop="14dp"
            android:translationZ="30dp"
            app:cardBackgroundColor="?colorSurface"
            app:cardCornerRadius="20dp"
            app:cardElevation="14dp"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="@color/rippleDark">

            <ImageView
                android:id="@+id/coverImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                bind:glideLoadImg="@{model.photoUrl}" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/titleTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_medium"
            android:maxLines="2"
            android:text="@{model.name}"
            android:textColor="@color/dove_gray"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/itemCv"
            app:layout_constraintStart_toStartOf="@+id/itemCv"
            app:layout_constraintTop_toBottomOf="@+id/itemCv" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>