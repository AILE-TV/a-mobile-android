<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="TextInputLayout" parent="Widget.AileTv.BaseTextInputLayout">
        <item name="hintTextColor">?inputLayoutNormalHintColor</item>
        <item name="helperTextTextColor">?inputLayoutHelperTextColor</item>
        <item name="endIconTint">?inputEditTextTextColor</item>
        <item name="prefixTextColor">?inputEditTextTextColor</item>
    </style>

    <style name="TextInputEditText" parent="Widget.AileTv.BaseTextInputEditText">
        <item name="android:textColor">?inputEditTextTextColor</item>
    </style>

    <style name="MaterialButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/selector_button_tint</item>
        <item name="android:textColor">@color/selector_button_text_color</item>
        <item name="textAllCaps">false</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:layout_marginEnd">56dp</item>
        <item name="iconTint">@null</item>
        <item name="rippleColor">@color/rippleDark</item>
    </style>

    <style name="MaterialButtonPinCode" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?colorOnBackground</item>
        <item name="textAllCaps">false</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/alto</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="ShapeAppearanceLogoutButton">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Toolbar">
        <item name="contentInsetStartWithNavigation">0dp</item>
        <item name="titleTextColor">?colorOnPrimary</item>
    </style>
</resources>