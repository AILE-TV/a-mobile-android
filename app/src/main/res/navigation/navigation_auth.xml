<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/authNavId"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/authFragment"
        android:name="com.ailetv.mobile.ui.auth.AuthFragment"
        android:label=""
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.ailetv.mobile.ui.auth.login.LoginFragment"
        android:label=""
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_to_otpFragment"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="com.ailetv.mobile.ui.auth.otp.OtpFragment"
        android:label=""
        tools:layout="@layout/fragment_otp">

        <argument
            android:name="utilModel"
            app:argType="com.ailetv.mobile.data.model.resource.util.AuthUtilModel" />
    </fragment>
</navigation>