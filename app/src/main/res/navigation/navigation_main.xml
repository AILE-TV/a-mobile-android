<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainNavId"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.ailetv.mobile.ui.dashboard.main.MainFragment"
        android:label=""
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/toInternetFragment"
            app:destination="@id/internetFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
        <action
            android:id="@+id/toTvFragment"
            app:destination="@id/tvFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
        <action
            android:id="@+id/toIpTvFragment"
            app:destination="@id/ipTvFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/bonusFragment"
        android:name="com.ailetv.mobile.ui.dashboard.main.bonus.BonusFragment"
        android:label=""
        tools:layout="@layout/fragment_bonus">
        <argument
            android:name="list"
            app:argType="com.ailetv.mobile.data.model.resource.ContractPOJO[]" />
    </fragment>

    <fragment
        android:id="@+id/internetFragment"
        android:name="com.ailetv.mobile.ui.dashboard.main.internet.InternetFragment"
        android:label=""
        tools:layout="@layout/fragment_internet">
        <argument
            android:name="contractPojo"
            app:argType="com.ailetv.mobile.data.model.resource.ContractPOJO" />
    </fragment>

    <fragment
        android:id="@+id/tvFragment"
        android:name="com.ailetv.mobile.ui.dashboard.main.tv.TvFragment"
        android:label=""
        tools:layout="@layout/fragment_tv">
        <argument
            android:name="contractPojo"
            app:argType="com.ailetv.mobile.data.model.resource.ContractPOJO" />
    </fragment>

    <fragment
        android:id="@+id/ipTvFragment"
        android:name="com.ailetv.mobile.ui.dashboard.main.ipTv.IpTvFragment"
        android:label=""
        tools:layout="@layout/fragment_ip_tv">

        <argument
            android:name="contractPojo"
            app:argType="com.ailetv.mobile.data.model.resource.ContractPOJO" />
    </fragment>


    <fragment
        android:id="@+id/paymentAmountFragment"
        android:name="com.ailetv.mobile.ui.dashboard.main.payment.PaymentAmountFragment"
        android:label=""
        tools:layout="@layout/fragment_payment_amount">
        <argument
            android:name="contractPojo"
            app:argType="com.ailetv.mobile.data.model.resource.ContractPOJO" />
    </fragment>

    <fragment
        android:id="@+id/webFragment"
        android:name="com.ailetv.mobile.ui.web.WebFragment"
        android:label=""
        tools:layout="@layout/fragment_web">

        <argument android:name="title" />
        <argument android:name="url" />
        <argument
            android:name="postData"
            app:nullable="true" />
        <argument
            android:name="webCanGoBack"
            app:argType="boolean" />
    </fragment>

    <action
        android:id="@+id/action_global_webFragment"
        app:destination="@id/webFragment" />

    <action
        android:id="@+id/action_global_paymentAmountFragment"
        app:destination="@id/paymentAmountFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim"
        app:popUpTo="@id/mainFragment" />

    <action
        android:id="@+id/action_global_bonusFragment"
        app:destination="@id/bonusFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim" />
</navigation>